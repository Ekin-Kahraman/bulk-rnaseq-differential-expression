cat > .gitignore << 'EOF'
# R session files
.Rhistory
.RData
.RDataTmp*
.Rproj.user/

# Derived data
data/raw/
data/*.rds
data/*.csv

# Results (ignore data, keep figures and tables)
results/*
!results/figures/
!results/figures/*.png
!results/tables/
!results/tables/*.csv

# OS
.DS_Store

# renv
renv/library/
renv/staging/
renv/sandbox/
EOF